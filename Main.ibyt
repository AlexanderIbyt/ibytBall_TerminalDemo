// Linux Terminal Demonstration Ball2
// (c) Alexander Zima - https://www.ibyt.tech

import <ConsoleGfx.ibyt>
import <Basic.ibyt>

define FRAME_DELAY: 50

// 3 Balls
// Movement vectors: dx/dy = direction step per frame (-1, 0 or +1)
int64 direction{ dx1, dy1, dx2, dy2, dx3, dy3 }

// Start positions: x/y coordinates on screen
int64 position{ x1, y1, x2, y2, x3, y3 }

// Array variables
// active: 0 = ball not yet visible, 1 = ball is active
// timer:  counts frames until a delayed ball appears
int64 active{ A2, A3 }
int64 timer{ T2, T3 }

Start{
    
    // Init
    call ConsoleGfx.UpdateSize(=)
    call ConsoleGfx.Clear(=)
    call ConsoleGfx.CursorOff(=)
    call ConsoleGfx.RawOn(=)

    // --- Define sprites ---
    prepare "#", 0, 0
    call ConsoleGfx.BuildSprite(_, keep base, keep temp, keep work)

    prepare "#", 0, 1
    call ConsoleGfx.BuildSprite(=)

    prepare "#", 0, 2
    call ConsoleGfx.BuildSprite(=)


    // --- BALL 1: start position & random direction ---
    prepare 5, 30
    call Basic.Random(keep base, keep temp, focus counter)
    position.x1: $counter
    
    prepare 3, 15
    call Basic.Random(=)
    position.y1: $counter
    
    // Draw ball 1 immediately
    prepare 0, position.x1, position.y1
    call ConsoleGfx.DrawSprite(_, keep base, keep temp, keep work, admin, keep peta)

    // Random horizontal direction: +1 or -1
    direction.dx1: 1
    prepare 0, 1
    call Basic.Random(=)
    if ($counter = 0){ 
    	direction.dx1: -1
    }
    
    // Random vertical direction: +1 or -1
    direction.dy1: 1
    prepare 0, 1
    call Basic.Random(=)
    if ($counter = 0){
    	direction.dy1: -1
    }


    // --- BALL 2: start position & random direction ---
    prepare 5, 30
    call Basic.Random(keep base, keep temp, focus counter)
    position.x2: $counter
    
    prepare 3, 15
    call Basic.Random(=)
    position.y2: $counter

    direction.dx2: 1
    prepare 0, 1 
    call Basic.Random(=)
    
    if ($counter = 0){
    	direction.dx2: -1
    }
    
    direction.dy2: 1
    prepare 0, 1
    call Basic.Random(=)
    if ($counter = 0){
    	direction.dy2: -1
    }


    // --- BALL 3: start position & random direction ---
    prepare 5, 30
    call Basic.Random(keep base, keep temp, focus counter)
    position.x3: $counter
    
    prepare 3, 15
    call Basic.Random(=)
    position.y3: $counter

    direction.dx3: 1
    prepare 0, 1
    call Basic.Random(=)
    
    if ($counter = 0){ 
    	direction.dx3: -1
    }
    direction.dy3: 1
    
    prepare 0, 1
    call Basic.Random(keep base, keep temp, focus counter)
    if ($counter = 0){
    	direction.dy3: -1
    }

	// ========================================
	// Game loop
	
    ->Loop->
    
        // Space key terminates the program
        call ConsoleGfx.GetKey(focus base, item, admin)
        goto_flag not_carry NoKey
        compare($base = 32) goto_true Ende
        
        ->NoKey->

        // ==========================================
        // --- BALL 1 (sprite 0): separate axes ---
        // ==========================================
        // 1. Move horizontally
        prepare 0, direction.dx1, 0
        call ConsoleGfx.MoveSprite(_, keep base, keep temp, keep work, admin, keep peta)
        goto_flag carry MoveY1
        // Collision -> reverse horizontal direction
        direction.dx1: 0 - direction.dx1

        ->MoveY1->
        // 2. Move vertically
        prepare 0, 0, direction.dy1
        call ConsoleGfx.MoveSprite(=)
        goto_flag carry CheckBall2
        // Collision -> reverse vertical direction
        direction.dy1: 0 - direction.dy1


        // ==========================================
        // --- BALL 2 (sprite 1) ---
        // ==========================================
        ->CheckBall2->
		    _: active.A2
		    if (_ = 0) {
		        // Ball 2 not yet active: count frames until appearance
		        timer.T2++
		        _: timer.T2
		        if (_ > 30) { 
		            active.A2: 1 
		            // Draw ball 2 for the first time
		            prepare 1, position.x2, position.y2
		            call ConsoleGfx.DrawSprite(_, keep base, keep temp, keep work, admin, keep peta)
		        }
		        goto CheckBall3
		    }

        // 1. Move horizontally
        prepare 1, direction.dx2, 0
        call ConsoleGfx.MoveSprite(=)
        goto_flag carry MoveY2
        direction.dx2: 0 - direction.dx2

        ->MoveY2->
		    // 2. Move vertically
		    prepare 1, 0, direction.dy2
		    call ConsoleGfx.MoveSprite(=)
		    goto_flag carry CheckBall3
		    direction.dy2: 0 - direction.dy2


        // ==========================================
        // --- BALL 3 (sprite 2) ---
        // ==========================================
        ->CheckBall3->
		    _: active.A3
		    if (_ = 0) {
		        // Ball 3 not yet active: count frames until appearance
		        timer.T3++
		        _: timer.T3
		        if (_ > 60) { 
		            active.A3: 1 
		            // Draw ball 3 for the first time
		            prepare 2, position.x3, position.y3
		            call ConsoleGfx.DrawSprite(_, keep base, keep temp, keep work, admin, keep peta)
		        }
		        goto FrameWait
		    }

        // 1. Move horizontally
        prepare 2, direction.dx3, 0
        call ConsoleGfx.MoveSprite(=)
        goto_flag carry MoveY3
        direction.dx3: 0 - direction.dx3

        ->MoveY3->
		    // 2. Move vertically
		    prepare 2, 0, direction.dy3
		    call ConsoleGfx.MoveSprite(=)
		    goto_flag carry FrameWait
		    direction.dy3: 0 - direction.dy3


        // --- FRAME DELAY ---
        ->FrameWait->
		    prepare FRAME_DELAY
		    call ConsoleGfx.Sleep(=)
		    goto Loop↑ // back to game loop

    ->Ende->
		// Restore terminal to normal state
		call ConsoleGfx.RawOff(=)
		call ConsoleGfx.ClearPoint(=)
		call ConsoleGfx.CursorOn(=)

    prepare 0, 0
    call ConsoleGfx.SetCursor(=)
}
